# Copy this file, name the copy ".env", and fill in your real values.
# The .env file is ignored by git, so your token never leaves your machine.

# Bot User OAuth Token from https://api.slack.com/apps
# (OAuth & Permissions page — it starts with "xoxb-")
# Paste the whole token after the = sign, with no quotes or spaces.
SLACK_BOT_TOKEN=

# The channel to read fitness posts from (no # needed)
SLACK_CHANNEL_NAME=doyoulikefitness
