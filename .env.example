# Copy this file, name the copy ".env", and fill in your real values.
# The .env file is ignored by git, so your token never leaves your machine.

# --- Legacy single-workspace path (Milestone 1-4, pre-multi-tenant) ---
# Bot User OAuth Token from https://api.slack.com/apps
# (OAuth & Permissions page — it starts with "xoxb-")
# Paste the whole token after the = sign, with no quotes or spaces.
SLACK_BOT_TOKEN=

# The channel to read fitness posts from (no # needed)
SLACK_CHANNEL_NAME=doyoulikefitness

# --- M2: real "Add to Slack" OAuth app (one app, works for every org) ---
# From https://api.slack.com/apps -> your app -> Basic Information
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
DATABASE_URL=

# Signs Flask's session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
