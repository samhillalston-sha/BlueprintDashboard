# Secrets — never upload the real token
.env

# Python's private sandbox and cache files
.venv/
__pycache__/
*.pyc

# The database file (arrives in Milestone 3) — data stays local
*.db
*.sqlite3

# Real team messages pulled from Slack — never publish these
data/

# Generated output (rebuilt any time with milestone4_dashboard.py) —
# leading slash so this only matches the root-level generated file, not
# templates/dashboard.html (the actual template source, which must be
# committed — a bare "dashboard.html" pattern here previously matched
# and silently swallowed that file too)
/dashboard.html
